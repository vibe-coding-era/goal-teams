      "expected_output": {"final_full_regression": "required", "reuse_prior_results": false, "denominator": "complete_frozen_regression_catalog"},
      "assertions": [
        {"assertion_id": "A-P0-LARGE-01", "actual_ref": "observed_output.reuse_prior_results", "comparator": "equals", "expected_ref": "expected_output.reuse_prior_results"},
        {"assertion_id": "A-P0-LARGE-02", "actual_ref": "observed_output.denominator", "comparator": "equals", "expected_ref": "expected_output.denominator"}
