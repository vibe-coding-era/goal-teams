{
  "schema_version": "goal-teams-flow-test-strategy-v2.47",
  "product_version": "V2.47",
  "schema": "schemas/v2.47/flow-test-strategy.schema.json",
  "validator": "scripts/checks/validate-v247-flow-test-strategy.py",
  "test_suites": {
    "incremental": {
      "denominator": "changed_behavior_and_direct_dependency_paths",
      "prior_result_reuse": "historical_only"
    },
    "p0_smoke": {
      "denominator": "all_applicable_p0_cases_for_selected_flow_and_product_surfaces",
      "prior_result_reuse": "historical_only"
    },
    "full_regression": {
      "denominator": "complete_frozen_regression_catalog",
      "prior_result_reuse": "forbidden_for_current_run"
    }
  },
  "flow_policies": {
    "small": {
      "required_during_work": ["incremental", "p0_smoke"],
      "final_full_regression": "not_required",
      "user_clarification_required": false,
      "reuse_prior_incremental_or_smoke_in_full_run": false
    },
    "medium": {
      "required_during_work": ["incremental", "p0_smoke"],
      "final_full_regression": "user_choice",
      "user_clarification_required": true,
      "unconfirmed_state": "awaiting_user_choice",
      "reuse_prior_incremental_or_smoke_in_full_run": false
    },
    "large": {
      "required_during_work": ["incremental", "p0_smoke"],
      "final_full_regression": "required",
      "user_clarification_required": false,
      "reuse_prior_incremental_or_smoke_in_full_run": false
    }
  },
  "product_surface_denominator": [
    "portable_core",
    "documentation",
    "cli",
    "backend",
    "api",
    "ui_original",
    "ui_replica",
    "desktop",
    "flow_routing",
    "ledger_harness_evidence",
    "prompt_cache_incremental_ssot",
    "runtime_compatibility",
    "response_contract",
    "self_release_guard"
  ],
  "p0_execution_scope": "deterministic_contract_smoke",
  "p0_cases": [
    {
      "case_id": "P0-V247-FLOW-SMALL",
      "scope_kind": "flow",
      "scope_id": "small",
      "input": {"flow_selection": "small", "changed_paths": ["RULES.md"]},
      "processing": {"kind": "compile_test_strategy"},
      "expected_output": {"required_suites": ["incremental", "p0_smoke"], "final_full_regression": "not_required"},
      "assertions": [
        {"assertion_id": "A-P0-SMALL-01", "actual_ref": "observed_output.required_suites", "comparator": "sequence_equals", "expected_ref": "expected_output.required_suites"},
        {"assertion_id": "A-P0-SMALL-02", "actual_ref": "observed_output.final_full_regression", "comparator": "equals", "expected_ref": "expected_output.final_full_regression"}
      ]
    },
    {
      "case_id": "P0-V247-FLOW-MEDIUM",
      "scope_kind": "flow",
      "scope_id": "medium",
      "input": {"flow_selection": "medium", "user_full_regression_choice": null},
      "processing": {"kind": "compile_test_strategy"},
      "expected_output": {"required_suites": ["incremental", "p0_smoke"], "clarification": "required", "full_regression_state": "awaiting_user_choice"},
      "assertions": [
        {"assertion_id": "A-P0-MEDIUM-01", "actual_ref": "observed_output.clarification", "comparator": "equals", "expected_ref": "expected_output.clarification"},
        {"assertion_id": "A-P0-MEDIUM-02", "actual_ref": "observed_output.full_regression_state", "comparator": "equals", "expected_ref": "expected_output.full_regression_state"}
      ]
    },
