{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goal-teams.local/schemas/v2.50/active-generation.schema.json",
  "$ref": "#/$defs/activeGeneration",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "activeGeneration": {
      "type": "object",
      "required": ["schema_version", "generation_id", "activation_manifest", "activation_manifest_sha256", "state", "updated_at"],
      "properties": {
        "schema_version": {"const": "goal-teams-active-generation-v1"},
        "generation_id": {"pattern": "^V[0-9]+\\.[0-9]+$"},
        "activation_manifest": {"$ref": "#/$defs/repoPath"},
        "activation_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "state": {"enum": ["active_current", "active_rollback"]},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  }
}
