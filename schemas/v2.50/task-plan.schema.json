{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goal-teams.local/schemas/v2.50/task-plan.schema.json",
  "type": "object",
  "required": ["schema_version", "plan_id", "plan_revision", "tasks", "phase_exact_sets"],
  "properties": {
    "schema_version": {"const": "goal-teams-task-plan-v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    },
    "phase_exact_sets": {
      "type": "object",
      "required": ["development", "runtime", "release"],
      "properties": {
        "development": {"$ref": "#/$defs/taskIds"},
        "runtime": {"$ref": "#/$defs/taskIds"},
        "release": {"$ref": "#/$defs/taskIds"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "taskIds": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "output": {
      "type": "object",
      "required": ["output_id", "consumer_refs", "required"],
      "properties": {
        "output_id": {"type": "string", "minLength": 1},
        "consumer_refs": {"$ref": "#/$defs/taskIds"},
        "required": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"required": {"const": true}}},
          "then": {
            "properties": {
              "consumer_refs": {"type": "array", "minItems": 1}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "admission": {
      "type": "object",
      "required": [
        "current_consumer_confirmed",
        "observable_acceptance_defined",
        "scope_locked",
        "budget_bound",
        "exit_condition_frozen",
        "evidence_refs"
      ],
      "properties": {
        "current_consumer_confirmed": {"const": true},
        "observable_acceptance_defined": {"const": true},
        "scope_locked": {"const": true},
        "budget_bound": {"const": true},
        "exit_condition_frozen": {"const": true},
        "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "verification_id",
        "verification_type",
        "method",
        "expected_result",
        "evidence_refs"
      ],
      "properties": {
        "verification_id": {"type": "string", "minLength": 1},
        "verification_type": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "expected_result": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "businessOracle": {
      "type": "object",
      "required": [
        "oracle_id",
        "oracle_type",
        "acceptance_criteria",
        "evidence_refs"
      ],
      "properties": {
        "oracle_id": {"type": "string", "minLength": 1},
        "oracle_type": {"type": "string", "minLength": 1},
        "acceptance_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
        "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "exitCondition": {
      "type": "object",
      "required": [
        "exit_id",
        "exit_type",
        "required_receipt_types",
        "on_budget_exhaustion"
      ],
      "properties": {
        "exit_id": {"type": "string", "minLength": 1},
        "exit_type": {"type": "string", "minLength": 1},
        "required_receipt_types": {"$ref": "#/$defs/nonEmptyStrings"},
        "on_budget_exhaustion": {"enum": ["replan", "blocked"]}
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": [
        "task_id", "requirement_refs", "consumer_refs", "admission", "owner", "validator",
        "scope_allowlist", "forbidden_scope", "depends_on", "budget_wu",
        "attempt_budget", "revalidation_budget", "inputs", "outputs",
        "verification", "business_oracle", "exit_condition", "failure_artifacts"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "requirement_refs": {"$ref": "#/$defs/nonEmptyStrings"},
        "consumer_refs": {"$ref": "#/$defs/nonEmptyStrings"},
        "admission": {"$ref": "#/$defs/admission"},
        "owner": {"type": "string", "minLength": 1},
        "validator": {"type": "string", "minLength": 1},
        "scope_allowlist": {"$ref": "#/$defs/nonEmptyStrings"},
        "forbidden_scope": {"$ref": "#/$defs/taskIds"},
        "depends_on": {"$ref": "#/$defs/taskIds"},
        "budget_wu": {"type": "integer", "minimum": 1},
        "attempt_budget": {"type": "integer", "minimum": 1},
        "revalidation_budget": {"type": "integer", "minimum": 0},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}},
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/verification"}
        },
        "business_oracle": {"$ref": "#/$defs/businessOracle"},
        "exit_condition": {"$ref": "#/$defs/exitCondition"},
        "failure_artifacts": {"$ref": "#/$defs/taskIds"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
