{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goal-teams.local/schemas/v2.50/activation-manifest.schema.json",
  "title": "Goal Teams V2.62 immutable activation manifest",
  "type": "object",
  "required": [
    "schema_version",
    "generation_id",
    "generation_state",
    "baseline_generation_id",
    "manifest_payload_sha256",
    "identity",
    "root_sets",
    "rule_manifest_path",
    "prompt_manifest_path",
    "semantic_owner_set_digest",
    "rule_index_digest",
    "prompt_plan_digest",
    "schema_and_validator_digest",
    "current_default_allowlist",
    "current_default_allowlist_digest",
    "optional_replay_allowlist_digest",
    "legacy_classification",
    "projection_writer_allowlist",
    "projection_writer_allowlist_digest",
    "fixture_and_completion_contract_digest",
    "repository_control_exclusions",
    "budgets",
    "rollback"
  ],
  "properties": {
    "schema_version": {"const": "goal-teams-activation-manifest-v2.50"},
    "generation_id": {"const": "V2.62"},
    "generation_state": {"enum": ["inactive_candidate", "active", "retired_replay_only"]},
    "baseline_generation_id": {"type": "string", "pattern": "^V[0-9]+\\.[0-9]+$"},
    "manifest_payload_sha256": {"$ref": "#/$defs/sha256"},
    "identity": {
      "type": "object",
      "required": ["loaded_runtime_product_version", "route_contract_schema_version", "target_policy_generation"],
      "properties": {
        "loaded_runtime_product_version": {"const": "V2.62"},
        "route_contract_schema_version": {"type": "string", "minLength": 1},
        "target_policy_generation": {"const": "V2.62"}
      },
      "additionalProperties": false
    },
    "root_sets": {
      "type": "object",
      "required": ["bootstrap", "current", "execution", "schemas_and_validators"],
      "properties": {
        "bootstrap": {"$ref": "#/$defs/digestedPaths"},
        "current": {"$ref": "#/$defs/digestedPaths"},
        "execution": {"$ref": "#/$defs/digestedPaths"},
        "schemas_and_validators": {"$ref": "#/$defs/digestedPaths"}
      },
      "additionalProperties": false
    },
    "rule_manifest_path": {"$ref": "#/$defs/repoPath"},
    "prompt_manifest_path": {"$ref": "#/$defs/repoPath"},
    "semantic_owner_set_digest": {"$ref": "#/$defs/sha256"},
    "rule_index_digest": {"$ref": "#/$defs/sha256"},
    "prompt_plan_digest": {"$ref": "#/$defs/sha256"},
    "schema_and_validator_digest": {"$ref": "#/$defs/sha256"},
    "current_default_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
    "current_default_allowlist_digest": {"$ref": "#/$defs/sha256"},
    "optional_replay_allowlist_digest": {"$ref": "#/$defs/sha256"},
    "legacy_classification": {
      "type": "object",
      "required": ["path_prefixes", "exact_paths", "replay_manifest_sha256"],
      "properties": {
        "path_prefixes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
        "exact_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
        "replay_manifest_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "projection_writer_allowlist": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
    "projection_writer_allowlist_digest": {"$ref": "#/$defs/sha256"},
    "fixture_and_completion_contract_digest": {"$ref": "#/$defs/sha256"},
    "repository_control_exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path_prefix", "reason", "binding"],
        "properties": {
          "path_prefix": {"const": ".github/workflows/"},
          "reason": {"const": "repository_only_not_installable_runtime_asset"},
          "binding": {"const": "exact_source_tree_plus_release_profile_and_command_contract"}
        },
        "additionalProperties": false
      }
    },
    "budgets": {
      "type": "object",
      "required": ["max_route_rule_bytes", "byte_count_algorithm"],
      "properties": {
        "max_route_rule_bytes": {"type": "integer", "minimum": 1},
        "byte_count_algorithm": {"const": "sum_raw_file_bytes_after_path_deduplication"}
      },
      "additionalProperties": false
    },
    "rollback": {
      "type": "object",
      "required": ["activation_manifest_path", "activation_manifest_sha256", "window_status"],
      "properties": {
        "activation_manifest_path": {"$ref": "#/$defs/repoPath"},
        "activation_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "window_status": {"enum": ["open", "closed"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repoPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"},
    "digestedPath": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "digestedPaths": {"type": "array", "items": {"$ref": "#/$defs/digestedPath"}}
  }
}
