{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goal-teams.local/schemas/v2.50/project-route.schema.json",
  "type": "object",
  "required": [
    "project_size",
    "workflow_phase",
    "release_intent",
    "implementation_scope_complete",
    "stage",
    "risk",
    "failure_consequence",
    "reversibility",
    "compliance",
    "external_write",
    "security_sensitive",
    "ui_or_desktop",
    "agent_runtime",
    "environment_check_required",
    "authorization_state",
    "facts_source_sha256"
  ],
  "properties": {
    "project_size": {"enum": ["discussion", "small", "medium", "large"]},
    "workflow_phase": {"enum": ["discussion", "development", "release_readiness", "release"]},
    "release_intent": {"type": "boolean"},
    "implementation_scope_complete": {"type": "boolean"},
    "stage": {"enum": ["candidate", "released"]},
    "s1_current": {"type": "boolean"},
    "released_runtime_transition_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_control_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_frozen": {"type": "boolean"},
    "development_denominator_id": {"type": "string", "minLength": 1},
    "release_denominator_id": {"type": "string", "minLength": 1},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "failure_consequence": {"enum": ["low", "medium", "high", "critical"]},
    "reversibility": {"enum": ["reversible", "partially_reversible", "irreversible"]},
    "compliance": {"enum": ["none", "standard", "regulated"]},
    "external_write": {"type": "boolean"},
    "security_sensitive": {"type": "boolean"},
    "ui_or_desktop": {"type": "boolean"},
    "agent_runtime": {"type": "boolean"},
    "environment_check_required": {"type": "boolean"},
    "authorization_state": {
      "enum": ["not_required", "granted", "missing", "expired", "denied"]
    },
    "facts_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_check_requested": {"type": "boolean"}
  },
  "additionalProperties": false
}
