{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goal-teams.local/schemas/v2.50/state-ledger.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "bindings": {
      "type": "object",
      "required": [
        "source_sha256",
        "route_sha256",
        "contract_sha256",
        "task_exact_set_sha256",
        "environment_sha256",
        "authorization_lineage_sha256"
      ],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "route_sha256": {"$ref": "#/$defs/sha256"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "task_exact_set_sha256": {"$ref": "#/$defs/sha256"},
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_lineage_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "taskVerificationObservations": {
      "type": "object",
      "required": ["task_id", "verification_contract_sha256", "outcome"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "verification_contract_sha256": {"$ref": "#/$defs/sha256"},
        "outcome": {"enum": ["passed", "failed", "blocked"]}
      },
      "additionalProperties": false
    },
    "taskExitObservations": {
      "type": "object",
      "required": [
        "task_id",
        "exit_condition_sha256",
        "verification_receipt_sha256",
        "condition_met"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "exit_condition_sha256": {"$ref": "#/$defs/sha256"},
        "verification_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "condition_met": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "phaseObservations": {
      "type": "object",
      "required": ["phase", "exact_task_ids", "denominator_sha256"],
      "properties": {
        "phase": {"const": "development"},
        "exact_task_ids": {"$ref": "#/$defs/stringSet"},
        "denominator_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "gitScopeObservations": {
      "type": "object",
      "required": ["baseline_sha256", "working_state_sha256", "in_scope"],
      "properties": {
        "baseline_sha256": {"$ref": "#/$defs/sha256"},
        "working_state_sha256": {"$ref": "#/$defs/sha256"},
        "in_scope": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "runtimeObservations": {
      "type": "object",
      "required": [
        "exact_task_ids",
        "observation_sha256",
        "host_execution_id",
        "fresh"
      ],
      "properties": {
        "exact_task_ids": {"$ref": "#/$defs/stringSet"},
        "observation_sha256": {"$ref": "#/$defs/sha256"},
        "host_execution_id": {"type": "string", "minLength": 1},
        "fresh": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "businessObservations": {
      "type": "object",
      "required": [
        "oracle_contract_sha256",
        "observation_sha256",
        "oracle_identity",
        "accepted"
      ],
      "properties": {
        "oracle_contract_sha256": {"$ref": "#/$defs/sha256"},
        "observation_sha256": {"$ref": "#/$defs/sha256"},
        "oracle_identity": {"type": "string", "minLength": 1},
        "accepted": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "releaseGateObservations": {
      "type": "object",
      "required": ["exact_task_ids", "frozen_identity_sha256", "gate_receipt_sha256"],
      "properties": {
        "exact_task_ids": {"$ref": "#/$defs/stringSet"},
        "frozen_identity_sha256": {"$ref": "#/$defs/sha256"},
        "gate_receipt_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "publicationObservations": {
      "type": "object",
      "required": [
        "tag_name",
        "release_id",
        "expected_tag_target_sha256",
        "observed_tag_target_sha256",
        "expected_asset_ids",
        "observed_asset_ids"
      ],
      "properties": {
        "tag_name": {"type": "string", "minLength": 1},
        "release_id": {"type": "string", "minLength": 1},
        "expected_tag_target_sha256": {"$ref": "#/$defs/sha256"},
        "observed_tag_target_sha256": {"$ref": "#/$defs/sha256"},
        "expected_asset_ids": {"$ref": "#/$defs/stringSet"},
        "observed_asset_ids": {"$ref": "#/$defs/stringSet"}
      },
      "additionalProperties": false
    },
    "installationObservations": {
      "type": "object",
      "required": [
        "expected_source_sha256",
        "observed_source_sha256",
        "expected_artifact_sha256",
        "observed_artifact_sha256",
        "expected_version",
        "observed_version",
        "expected_canonical_path",
        "observed_canonical_path"
      ],
      "properties": {
        "expected_source_sha256": {"$ref": "#/$defs/sha256"},
        "observed_source_sha256": {"$ref": "#/$defs/sha256"},
        "expected_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "observed_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "expected_version": {"type": "string", "minLength": 1},
        "observed_version": {"type": "string", "minLength": 1},
        "expected_canonical_path": {"type": "string", "minLength": 1},
        "observed_canonical_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "gapObservations": {
      "type": "object",
      "required": ["open_gap_ids"],
      "properties": {"open_gap_ids": {"$ref": "#/$defs/stringSet"}},
      "additionalProperties": false
    },
    "validationReceipt": {
      "type": "object",
      "required": [
        "schema_version",
        "receipt_type",
        "subject_id",
        "status",
        "bindings",
        "evidence_refs",
        "observations",
        "validator_identity",
        "issued_at",
        "receipt_digest"
      ],
      "properties": {
        "schema_version": {"const": "goal-teams-validation-receipt-v2.65"},
        "receipt_type": {
          "enum": [
            "task_verification",
            "task_exit",
            "development_denominator",
            "git_scope",
            "runtime_observation",
            "business_validation",
            "release_gate",
            "release_publication",
            "installation_readback",
            "open_gap_audit"
          ]
        },
        "subject_id": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not_run",
            "not_required",
            "stale",
            "invalid",
            "unavailable"
          ]
        },
        "bindings": {"$ref": "#/$defs/bindings"},
        "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"},
        "observations": {
          "oneOf": [
            {"$ref": "#/$defs/taskVerificationObservations"},
            {"$ref": "#/$defs/taskExitObservations"},
            {"$ref": "#/$defs/phaseObservations"},
            {"$ref": "#/$defs/gitScopeObservations"},
            {"$ref": "#/$defs/runtimeObservations"},
            {"$ref": "#/$defs/businessObservations"},
            {"$ref": "#/$defs/releaseGateObservations"},
            {"$ref": "#/$defs/publicationObservations"},
            {"$ref": "#/$defs/installationObservations"},
            {"$ref": "#/$defs/gapObservations"}
          ]
        },
        "validator_identity": {"type": "string", "minLength": 1},
        "issued_at": {"type": "string", "minLength": 1},
        "receipt_digest": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "budgetEvent": {
      "type": "object",
      "required": [
        "schema_version",
        "event_id",
        "event_seq",
        "previous_event_sha256",
        "cas_base_revision",
        "task_id",
        "consumption_type",
        "amount",
        "task_exact_set_digest",
        "compiled_plan_receipt_digest",
        "actor_identity",
        "evidence_refs",
        "occurred_at",
        "event_sha256"
      ],
      "properties": {
        "schema_version": {"const": "goal-teams-budget-event-v1"},
        "event_id": {"type": "string", "minLength": 1},
        "event_seq": {"type": "integer", "minimum": 1},
        "previous_event_sha256": {"$ref": "#/$defs/sha256"},
        "cas_base_revision": {"type": "integer", "minimum": 0},
        "task_id": {"type": "string", "minLength": 1},
        "consumption_type": {"enum": ["work_unit", "attempt", "revalidation"]},
        "amount": {"type": "integer", "minimum": 1},
        "task_exact_set_digest": {"$ref": "#/$defs/sha256"},
        "compiled_plan_receipt_digest": {"$ref": "#/$defs/sha256"},
        "actor_identity": {"const": "state_reducer"},
        "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"},
        "occurred_at": {"type": "string", "minLength": 1},
        "event_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "schema_version",
        "event_id",
        "event_seq",
        "event_type",
        "axis",
        "entity_id",
        "previous_event_sha256",
        "cas_base_revision",
        "before_state",
        "requested_state",
        "bindings",
        "actor_identity",
        "actor_relationship",
        "evidence_refs",
        "occurred_at",
        "event_sha256"
      ],
      "properties": {
        "schema_version": {"const": "goal-teams-state-event-v2.65"},
        "event_id": {"type": "string", "minLength": 1},
        "event_seq": {"type": "integer", "minimum": 1},
        "event_type": {
          "enum": [
            "task.transition",
            "check.transition",
            "evidence.transition",
            "audit.transition",
            "run.transition",
            "goal.transition"
          ]
        },
        "axis": {"enum": ["task", "check", "evidence", "audit", "run", "goal"]},
        "entity_id": {"type": "string", "minLength": 1},
        "previous_event_sha256": {"$ref": "#/$defs/sha256"},
        "cas_base_revision": {"type": "integer", "minimum": 0},
        "before_state": {"type": "string", "minLength": 1},
        "requested_state": {"type": "string", "minLength": 1},
        "bindings": {"$ref": "#/$defs/bindings"},
        "actor_identity": {"type": "string", "minLength": 1},
        "actor_relationship": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "occurred_at": {"type": "string", "minLength": 1},
        "event_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "type": "array",
  "items": {"$ref": "#/$defs/event"}
}
