{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goal-teams.local/schemas/v2.50/runtime-transition-receipt.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitIdentity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
    "controllerHandoffReceipt": {
      "type": "object",
      "required": ["schema_version", "signed_payload", "payload_sha256", "ssh_signature"],
      "properties": {
        "schema_version": {"const": "goal-teams-v2.52-controller-handoff-receipt-v1"},
        "signed_payload": {
          "type": "object",
          "required": [
            "repository",
            "source_commit",
            "source_tree",
            "authorization_id",
            "authorization_receipt_sha256",
            "authorization_intent_sha256",
            "previous_controller_product_version",
            "previous_run_id",
            "nonce",
            "issued_at",
            "expires_at",
            "installed_v250_current_state",
            "github_signing_identity"
          ],
          "properties": {
            "repository": {"const": "vibe-coding-era/goal-teams"},
            "source_commit": {"$ref": "#/$defs/gitIdentity"},
            "source_tree": {"$ref": "#/$defs/gitIdentity"},
            "authorization_id": {"type": "string", "minLength": 1},
            "authorization_receipt_sha256": {"$ref": "#/$defs/sha256"},
            "authorization_intent_sha256": {"$ref": "#/$defs/sha256"},
            "previous_controller_product_version": {"const": "V2.50"},
            "previous_run_id": {"$ref": "#/$defs/runId"},
            "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"},
            "issued_at": {"type": "string", "format": "date-time"},
            "expires_at": {"type": "string", "format": "date-time"},
            "installed_v250_current_state": {
              "type": "object",
              "required": ["state_sha256", "source_commit", "source_tree", "tag", "release_id"],
              "properties": {
                "state_sha256": {"$ref": "#/$defs/sha256"},
                "source_commit": {"$ref": "#/$defs/gitIdentity"},
                "source_tree": {"$ref": "#/$defs/gitIdentity"},
                "tag": {"const": "v2.50"},
                "release_id": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            },
            "github_signing_identity": {
              "type": "object",
              "required": ["account", "key_id", "public_key", "public_key_fingerprint", "ssh_signature_namespace"],
              "properties": {
                "account": {"const": "vibe-coding-era"},
                "key_id": {"const": 152596014},
                "public_key": {"const": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ7qqfn52U2nhALTYS8ofXEwJwIq6GispivX9W/NG2Ot"},
                "public_key_fingerprint": {"const": "SHA256:fEM2bYLJFOSvNA78soiWLvrSUaWxANVr1HIVl6AAirE"},
                "ssh_signature_namespace": {"const": "goal-teams-v2.52-controller-handoff"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "ssh_signature": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "runtimeLaunchReceipt": {
      "type": "object",
      "required": [
        "schema_version",
        "controller_handoff_receipt_sha256",
        "controller_handoff_payload_sha256",
        "nonce",
        "parent_pid",
        "expected_child_pid",
        "host_execution_id",
        "new_run_id",
        "launched_at",
        "adapter_identity",
        "adapter_code_sha256",
        "receipt_sha256"
      ],
      "properties": {
        "schema_version": {"const": "goal-teams-v2.52-runtime-launch-receipt-v1"},
        "controller_handoff_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "controller_handoff_payload_sha256": {"$ref": "#/$defs/sha256"},
        "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"},
        "parent_pid": {"type": "integer", "minimum": 1},
        "expected_child_pid": {"type": "integer", "minimum": 1},
        "host_execution_id": {"$ref": "#/$defs/runId"},
        "new_run_id": {"$ref": "#/$defs/runId"},
        "launched_at": {"type": "string", "format": "date-time"},
        "adapter_identity": {"type": "string", "minLength": 1},
        "adapter_code_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "transition_id",
    "stage",
    "source_commit",
    "source_tree",
    "generation_id",
    "loaded_runtime_product_version",
    "project_size",
    "route_id",
    "route_receipt_path",
    "route_receipt_sha256",
    "route_closure_digest",
    "authorization_receipt_path",
    "authorization_receipt_sha256",
    "authorization_id",
    "authorization_lineage_preserved",
    "authorization_intent_sha256",
    "adapter_identity",
    "adapter_code_path",
    "adapter_code_sha256",
    "controller_handoff_receipt",
    "controller_handoff_receipt_sha256",
    "controller_handoff_signature_verified",
    "runtime_launch_receipt",
    "runtime_launch_receipt_sha256",
    "host_execution_id",
    "captured_at",
    "fresh_process_observed",
    "fresh_process_kind",
    "runner_pid",
    "orchestrator_pid",
    "actor_assurance",
    "actor_relationship",
    "independence_claim",
    "external_independent",
    "cryptographic_host_attestation",
    "activation_manifest_path",
    "prompt_manifest_path",
    "release_profile_path",
    "policy_profile_path",
    "release_route_manifest_path",
    "release_command_manifest_path",
    "root_agents_sha256",
    "root_skill_sha256",
    "active_pointer_sha256",
    "activation_manifest_sha256",
    "prompt_manifest_sha256",
    "release_profile_sha256",
    "policy_profile_sha256",
    "release_route_manifest_sha256",
    "release_command_manifest_sha256",
    "current_loaded_paths",
    "current_input_digests",
    "input_digests",
    "loaded_paths",
    "receipt_state",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "goal-teams-v2.52-runtime-transition-receipt-v1"},
    "transition_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["candidate", "released"]},
    "source_commit": {"$ref": "#/$defs/gitIdentity"},
    "source_tree": {"$ref": "#/$defs/gitIdentity"},
    "generation_id": {"const": "V2.52"},
    "loaded_runtime_product_version": {"const": "V2.52"},
    "project_size": {"enum": ["discussion", "small", "medium", "large"]},
    "route_id": {"type": "string", "pattern": "^V250-ROUTE-[A-Z-]+$"},
    "route_receipt_path": {"type": "string", "minLength": 1},
    "route_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "route_closure_digest": {"$ref": "#/$defs/sha256"},
    "authorization_receipt_path": {"type": "string", "minLength": 1},
    "authorization_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_id": {"type": "string", "minLength": 1},
    "authorization_lineage_preserved": {"const": true},
    "authorization_intent_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_identity": {"type": "string", "minLength": 1},
    "adapter_code_path": {"type": "string", "minLength": 1},
    "adapter_code_sha256": {"$ref": "#/$defs/sha256"},
    "controller_handoff_receipt": {"$ref": "#/$defs/controllerHandoffReceipt"},
    "controller_handoff_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "controller_handoff_signature_verified": {"const": true},
    "runtime_launch_receipt": {"$ref": "#/$defs/runtimeLaunchReceipt"},
    "runtime_launch_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "host_execution_id": {"$ref": "#/$defs/runId"},
    "captured_at": {"type": "string", "format": "date-time"},
    "fresh_process_observed": {"const": true},
    "fresh_process_kind": {"const": "host_adapter_popen_child"},
    "runner_pid": {"type": "integer", "minimum": 1},
    "orchestrator_pid": {"type": "integer", "minimum": 1},
    "actor_assurance": {"const": "I1"},
    "actor_relationship": {"const": "correlated"},
    "independence_claim": {"const": false},
    "external_independent": {"const": false},
    "cryptographic_host_attestation": {"const": false},
    "activation_manifest_path": {"type": "string", "minLength": 1},
    "prompt_manifest_path": {"type": "string", "minLength": 1},
    "release_profile_path": {"const": "references/release-profiles/v2.50.json"},
    "policy_profile_path": {"const": "references/profiles/goal-teams-self-release-v2.50.md"},
    "release_route_manifest_path": {"const": "references/current/generations/V2.52/contracts/release-route-manifest.json"},
    "release_command_manifest_path": {"const": "references/current/generations/V2.52/contracts/release-command-manifest.json"},
    "root_agents_sha256": {"$ref": "#/$defs/sha256"},
    "root_skill_sha256": {"$ref": "#/$defs/sha256"},
    "active_pointer_sha256": {"$ref": "#/$defs/sha256"},
    "activation_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "release_profile_sha256": {"$ref": "#/$defs/sha256"},
    "policy_profile_sha256": {"$ref": "#/$defs/sha256"},
    "release_route_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "release_command_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "current_loaded_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "current_input_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "input_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "loaded_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "receipt_state": {"const": "current"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false
}
