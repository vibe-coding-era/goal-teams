{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vibe-coding-era/goal-teams/schemas/release-engine-profile.schema.json",
  "title": "Goal Teams release engine profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "status",
    "external_writes_allowed",
    "published_before",
    "tag",
    "candidate_branch",
    "profile_path",
    "release_title",
    "release_body",
    "tag_message",
    "snapshot_schema_version",
    "files_manifest_format"
  ],
  "properties": {
    "schema_version": {"const": "goal-teams-release-engine-profile-v1"},
    "protocol_version": {"const": "V2.40"},
    "version": {"type": "string", "pattern": "^V[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["active", "historical_replay"]},
    "external_writes_allowed": {"type": "boolean"},
    "release_mode": {"const": "skill_simple"},
    "approval_model": {
      "enum": [
        "single_human_before_external_write",
        "project_start_authorization_reused"
      ]
    },
    "release_gates": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "published_before": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^V[0-9]+\\.[0-9]+$"}
      ]
    },
    "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "candidate_location": {
      "type": "string",
      "pattern": "^develops/[a-z0-9][a-z0-9._-]*$"
    },
    "candidate_branch": {
      "type": "string",
      "pattern": "^codex/[A-Za-z0-9._/-]+$"
    },
    "goal_teams_work": {
      "type": "string",
      "pattern": "^GoalTeamsWork-V[0-9]+\\.[0-9]+$"
    },
    "goal_teams_work_location": {
      "enum": ["candidate", "workspace_docs"]
    },
    "owner_run_id": {
      "type": "string",
      "pattern": "^RUN-V[0-9]+-LEAD$"
    },
    "profile_path": {
      "type": "string",
      "pattern": "^references/profiles/goal-teams-self-release-v[0-9]+\\.[0-9]+\\.md$"
    },
    "release_title": {"type": "string", "minLength": 1},
    "release_body": {"type": "string", "minLength": 1},
    "tag_message": {"type": "string", "minLength": 1},
    "workflow_display_prefix": {"type": "string", "minLength": 1},
    "legacy_recovery_required": {"type": "boolean"},
    "snapshot_schema_version": {
      "const": "goal-teams-release-snapshot-v2.40"
    },
    "files_manifest_format": {
      "const": "sha256-mode-size-path-v1"
    },
    "required_status_checks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "development_gate_policy": {"const": "tdd_and_incremental_only"},
    "release_readiness_policy": {
      "const": "released_identity_final_full_and_security_once"
    },
    "s2_policy": {
      "const": "single_build_release_versions_no_reproducibility_or_security"
    },
    "s3_policy": {
      "const": "large_release_only_after_current_s1_and_repository_boundary"
    },
    "s4_authorization_source": {
      "const": "project_start_authorization_receipt"
    },
    "repository_boundary_gate": {"const": "repository_boundary_compliance"},
    "runtime_transition_assurance": {"const": "I1_correlated"},
    "git_transport": {"const": "ssh_only"},
    "public_asset_map_path": {
      "enum": [
        "references/current/generations/V2.49/contracts/public-asset-map.json",
        "references/current/generations/V2.50/contracts/public-asset-map.json",
        "references/current/generations/V2.52/contracts/public-asset-map.json"
      ]
    },
    "public_scan_baseline": {
      "type": "string",
      "pattern": "^references/public-release-scan-baseline-v[0-9]+\\.[0-9]+\\.json$"
    },
    "close_schema_version": {
      "type": "string",
      "pattern": "^goal-teams-release-close-v[0-9]+\\.[0-9]+$"
    },
    "host_acceptance": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "algorithm",
            "signature_domain",
            "issuer",
            "public_key_hex",
            "key_id"
          ],
          "properties": {
            "schema_version": {
              "const": "goal-teams-external-host-acceptance-v2"
            },
            "algorithm": {"const": "Ed25519"},
            "signature_domain": {
              "type": "string",
              "pattern": "^goal-teams/v[0-9]+\\.[0-9]+/cp05/host-acceptance/ed25519/v1$"
            },
            "issuer": {"const": "goal-teams-trusted-host"},
            "public_key_hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "key_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"version": {"enum": ["V2.48", "V2.49", "V2.50", "V2.52"]}},
        "required": ["version"]
      },
      "then": {
        "required": ["release_mode", "approval_model", "release_gates"],
        "properties": {
          "release_mode": {},
          "approval_model": {},
          "release_gates": {},
          "external_writes_allowed": {"const": false}
        }
      },
      "else": {
        "required": [
          "protocol_version",
          "candidate_location",
          "goal_teams_work",
          "goal_teams_work_location",
          "owner_run_id",
          "workflow_display_prefix",
          "legacy_recovery_required",
          "public_scan_baseline",
          "close_schema_version",
          "host_acceptance"
        ],
        "properties": {
          "protocol_version": {},
          "candidate_location": {},
          "goal_teams_work": {},
          "goal_teams_work_location": {},
          "owner_run_id": {},
          "workflow_display_prefix": {},
          "legacy_recovery_required": {},
          "public_scan_baseline": {},
          "close_schema_version": {},
          "host_acceptance": {}
        }
      }
    },
    {
      "if": {
        "properties": {"version": {"const": "V2.48"}},
        "required": ["version"]
      },
      "then": {
        "properties": {
          "approval_model": {"const": "single_human_before_external_write"},
          "release_gates": {
            "const": [
              "source_freeze",
              "checks",
              "package",
              "isolated_install",
              "publish"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"version": {"enum": ["V2.49", "V2.50", "V2.52"]}},
        "required": ["version"]
      },
      "then": {
        "required": [
          "required_status_checks",
          "development_gate_policy",
          "release_readiness_policy",
          "s2_policy",
          "s3_policy",
          "s4_authorization_source",
          "repository_boundary_gate",
          "runtime_transition_assurance",
          "git_transport",
          "public_asset_map_path"
        ],
        "properties": {
          "required_status_checks": {},
          "development_gate_policy": {},
          "release_readiness_policy": {},
          "s2_policy": {},
          "s3_policy": {},
          "s4_authorization_source": {},
          "repository_boundary_gate": {},
          "runtime_transition_assurance": {},
          "git_transport": {},
          "public_asset_map_path": {},
          "approval_model": {"const": "project_start_authorization_reused"},
          "release_gates": {
            "const": [
              "source_freeze",
              "release_readiness",
              "single_build",
              "repository_boundary_compliance",
              "large_release_install",
              "publish"
            ]
          },
          "s2_policy": {
            "const": "single_build_release_versions_no_reproducibility_or_security"
          },
          "s3_policy": {
            "const": "large_release_only_after_current_s1_and_repository_boundary"
          }
        }
      }
    }
  ]
}
