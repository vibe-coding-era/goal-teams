{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goal-teams.local/schemas/v2.65/host-capability.schema.json",
  "title": "Goal Teams V2.65 Host Capability and Approval Contracts",
  "oneOf": [
    { "$ref": "#/$defs/capabilityReceipt" },
    { "$ref": "#/$defs/capabilityRequest" },
    { "$ref": "#/$defs/capabilityDecision" },
    { "$ref": "#/$defs/approvalReceipt" },
    { "$ref": "#/$defs/approvalDecision" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "stringSet": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "issuerAssurance": {
      "enum": ["repository_fixture", "host_correlated", "externally_attested"]
    },
    "actorRelationship": {
      "enum": ["self", "correlated", "independent"]
    },
    "proofStrength": {
      "enum": ["fixture_only", "correlated", "externally_attested"]
    },
    "permissionEffect": {
      "enum": ["none", "local_execution", "external_side_effects"]
    },
    "capabilityReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "capability_id",
        "issuer",
        "issuer_key_id",
        "issuer_assurance",
        "actor_relationship",
        "proof_strength",
        "host_execution_id",
        "node_id",
        "owner_run_id",
        "graph_contract_sha256",
        "scope_allowlist",
        "forbidden_scope",
        "scope_sha256",
        "tool_allowlist",
        "network_policy",
        "workspace_policy",
        "workspace_realpath",
        "not_before",
        "issued_at",
        "expires_at",
        "freshness_state",
        "permission_effect",
        "attestation_ref",
        "receipt_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "goal-teams-host-capability-receipt-v2.65"
        },
        "capability_id": { "$ref": "#/$defs/nonEmptyString" },
        "issuer": { "$ref": "#/$defs/nonEmptyString" },
        "issuer_key_id": { "$ref": "#/$defs/nonEmptyString" },
        "issuer_assurance": { "$ref": "#/$defs/issuerAssurance" },
        "actor_relationship": { "$ref": "#/$defs/actorRelationship" },
        "proof_strength": { "$ref": "#/$defs/proofStrength" },
        "host_execution_id": { "$ref": "#/$defs/nonEmptyString" },
        "node_id": { "$ref": "#/$defs/nonEmptyString" },
        "owner_run_id": { "$ref": "#/$defs/nonEmptyString" },
        "graph_contract_sha256": { "$ref": "#/$defs/sha256" },
        "scope_allowlist": { "$ref": "#/$defs/nonEmptyStringSet" },
        "forbidden_scope": { "$ref": "#/$defs/stringSet" },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "tool_allowlist": { "$ref": "#/$defs/nonEmptyStringSet" },
        "network_policy": { "enum": ["deny", "declared"] },
        "workspace_policy": {
          "enum": ["read_only", "node_scope", "isolated_worktree"]
        },
        "workspace_realpath": { "$ref": "#/$defs/nonEmptyString" },
        "not_before": { "$ref": "#/$defs/timestamp" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "freshness_state": { "enum": ["current", "stale", "invalid"] },
        "permission_effect": { "$ref": "#/$defs/permissionEffect" },
        "attestation_ref": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonEmptyString" }
          ]
        },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "capabilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "node_id",
        "task_id",
        "attempt",
        "action_ref",
        "owner_run_id",
        "graph_contract_sha256",
        "scope_sha256",
        "context_bundle_sha256",
        "capability_receipt_sha256",
        "requested_at",
        "request_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "goal-teams-host-capability-request-v2.65"
        },
        "run_id": { "$ref": "#/$defs/nonEmptyString" },
        "node_id": { "$ref": "#/$defs/nonEmptyString" },
        "task_id": { "$ref": "#/$defs/nonEmptyString" },
        "attempt": { "type": "integer", "minimum": 1 },
        "action_ref": { "$ref": "#/$defs/nonEmptyString" },
        "owner_run_id": { "$ref": "#/$defs/nonEmptyString" },
        "graph_contract_sha256": { "$ref": "#/$defs/sha256" },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "context_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "capability_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "requested_at": { "$ref": "#/$defs/timestamp" },
        "request_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "capabilityDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "verified",
        "issuer",
        "issuer_key_id",
        "issuer_assurance",
        "actor_relationship",
        "proof_strength",
        "permission_effect",
        "freshness_state",
        "scope_sha256",
        "node_id",
        "capability_receipt_sha256",
        "request_sha256",
        "reason_code",
        "decision_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "goal-teams-host-capability-decision-v2.65"
        },
        "verified": { "type": "boolean" },
        "issuer": { "$ref": "#/$defs/nonEmptyString" },
        "issuer_key_id": { "$ref": "#/$defs/nonEmptyString" },
        "issuer_assurance": { "$ref": "#/$defs/issuerAssurance" },
        "actor_relationship": { "$ref": "#/$defs/actorRelationship" },
        "proof_strength": { "$ref": "#/$defs/proofStrength" },
        "permission_effect": { "$ref": "#/$defs/permissionEffect" },
        "freshness_state": { "enum": ["current", "stale", "invalid"] },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "node_id": { "$ref": "#/$defs/nonEmptyString" },
        "capability_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "reason_code": { "$ref": "#/$defs/nonEmptyString" },
        "decision_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "approvalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "approval_id",
        "issuer",
        "issuer_key_id",
        "issuer_assurance",
        "actor_relationship",
        "proof_strength",
        "interrupt_id",
        "gate_id",
        "scope_sha256",
        "decision",
        "not_before",
        "issued_at",
        "expires_at",
        "permission_effect",
        "attestation_ref",
        "receipt_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "goal-teams-host-approval-receipt-v2.65"
        },
        "approval_id": { "$ref": "#/$defs/nonEmptyString" },
        "issuer": { "$ref": "#/$defs/nonEmptyString" },
        "issuer_key_id": { "$ref": "#/$defs/nonEmptyString" },
        "issuer_assurance": { "$ref": "#/$defs/issuerAssurance" },
        "actor_relationship": { "$ref": "#/$defs/actorRelationship" },
        "proof_strength": { "$ref": "#/$defs/proofStrength" },
        "interrupt_id": { "$ref": "#/$defs/nonEmptyString" },
        "gate_id": { "$ref": "#/$defs/nonEmptyString" },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "decision": { "enum": ["approve", "reject"] },
        "not_before": { "$ref": "#/$defs/timestamp" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "permission_effect": { "$ref": "#/$defs/permissionEffect" },
        "attestation_ref": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonEmptyString" }
          ]
        },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "approvalDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "verified",
        "issuer",
        "issuer_key_id",
        "issuer_assurance",
        "actor_relationship",
        "proof_strength",
        "permission_effect",
        "freshness_state",
        "scope_sha256",
        "interrupt_id",
        "approval_receipt_sha256",
        "expires_at",
        "reason_code",
        "decision_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "goal-teams-host-approval-decision-v2.65"
        },
        "verified": { "type": "boolean" },
        "issuer": { "$ref": "#/$defs/nonEmptyString" },
        "issuer_key_id": { "$ref": "#/$defs/nonEmptyString" },
        "issuer_assurance": { "$ref": "#/$defs/issuerAssurance" },
        "actor_relationship": { "$ref": "#/$defs/actorRelationship" },
        "proof_strength": { "$ref": "#/$defs/proofStrength" },
        "permission_effect": { "$ref": "#/$defs/permissionEffect" },
        "freshness_state": { "enum": ["current", "stale", "invalid"] },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "interrupt_id": { "$ref": "#/$defs/nonEmptyString" },
        "approval_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "reason_code": { "$ref": "#/$defs/nonEmptyString" },
        "decision_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
